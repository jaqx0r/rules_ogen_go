"""Bazel rules for running ogen-go to generate OpenAPI service handlers in Go."""

module(
    name = "rules_ogen_go",
)

bazel_dep(name = "rules_go", version = "0.64.1")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

bazel_dep(name = "gazelle", version = "0.54.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_go_faster_errors",
    "com_github_go_faster_jx",
    "com_github_ogen_go_ogen",
    "com_github_yuin_goldmark",
    "io_opentelemetry_go_otel",
    "io_opentelemetry_go_otel_metric",
    "io_opentelemetry_go_otel_trace",
)

bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)
